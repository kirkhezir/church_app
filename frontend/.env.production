# ============================================
# Production Environment Configuration
# ============================================
# Loaded automatically by Vite when running `vite build`
# (default mode is "production")
#
# Priority order (highest wins):
#   1. Host env vars (Vercel dashboard)
#   2. This file (.env.production)
#   3. .env (gitignored, local only)
#
# For local development, create a .env file with
# localhost values — Vite dev server uses "development"
# mode, so this file is NOT loaded during `npm run dev`.
# ============================================

# Backend API (Render)
VITE_API_URL="https://church-app-backend-u1zu.onrender.com/api/v1"

# WebSocket URL (same Render host, no path)
VITE_WS_URL="https://church-app-backend-u1zu.onrender.com"

# Sentry — enabled in production
VITE_SENTRY_ENABLED=true
VITE_SENTRY_ENVIRONMENT="production"
