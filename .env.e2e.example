# ============================================================
# E2E Test Credentials — Playwright
# ============================================================
# NEVER commit the real .env.e2e file. This is the template.
# 1. Copy this file:  cp .env.e2e.example .env.e2e
# 2. Fill in the seed user passwords (see backend/prisma/seed.ts)
# 3. The .env.e2e file is gitignored and will not be committed.
#
# In CI (GitHub Actions): set these as repository secrets and
# pass them as environment variables in the workflow step.
# ============================================================

# Frontend base URL (defaults to http://localhost:5173)
E2E_BASE_URL=http://localhost:5173

# Admin user (seeded by backend/prisma/seed.ts)
E2E_ADMIN_EMAIL=admin@singburi-adventist.org
E2E_ADMIN_PASSWORD=<seed-admin-password>

# Member user (seeded by backend/prisma/seed.ts)
E2E_MEMBER_EMAIL=john.doe@example.com
E2E_MEMBER_PASSWORD=<seed-member-password>
